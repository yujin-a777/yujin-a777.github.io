# Vercel 배포에서 제외할 파일/폴더 (문법: .gitignore와 동일)
# 목표: 공개 배포에는 HTML·CSS·브라우저 JS·이미지와 api/ 서버 함수만 남긴다.

# IDE·에이전트 설정 (MCP 토큰·OAuth 등 민감정보 포함)
.kiro/

# 기획·개발 문서 (개인 기록)
docs/

# 과거 Netlify 로컬 폴더 (남아 있을 경우 대비)
.netlify/

# 환경변수·비밀 (로컬에 생성될 경우 대비)
.env
.env.*
!.env.example

# 의존성
node_modules/

# 시스템 파일
.DS_Store
Thumbs.db
