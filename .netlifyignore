# Netlify 공개 출력(CDN)에서 제외할 파일/폴더
# 문법: .gitignore와 동일
# 목표: 공개 출력에는 HTML·CSS·브라우저 JS·이미지만 남긴다.

# ── 버전 관리 메타데이터 ──
.git/
.gitignore
.gitattributes

# ── IDE·에이전트 설정 (MCP 토큰·OAuth 등 민감정보 포함) ──
.kiro/

# ── 기획·개발 문서 (개인 기록) ──
docs/

# ── 서버 함수 소스 (공개 CDN에 정적 파일로 노출 금지) ──
# netlify/functions/*.js 는 빌드 시 Lambda로 따로 번들되며,
# publish 루트(.)에 정적 파일로 복사되면 안 된다.
netlify/

# ── 배포 설정 파일 (공개 출력에 포함할 필요 없음) ──
netlify.toml
.netlifyignore

# ── 환경변수·비밀 (로컬에 생성될 경우 대비) ──
.env
.env.*
!.env.example

# ── 의존성 ──
node_modules/

# ── 시스템 파일 ──
.DS_Store
Thumbs.db
